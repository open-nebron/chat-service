PORT=4003
NODE_ENV=development
LOG_LEVEL=info
SCYLLA_HOSTS=scylla:9042
SCYLLA_KEYSPACE=nebron
SCYLLA_DATACENTER=datacenter1
REDIS_URL=redis://redis:6379
AUTH_JWKS_URL=http://auth:4001/.well-known/jwks.json
JWT_ISSUER=nebron-auth
JWT_AUDIENCE=chat
EVENTS_STREAM=nebron.events
EVENTS_GROUP=chat-service
CORE_URL=http://core:4002
INTERNAL_TOKEN=dev-internal-token-change-me
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_RATE_LIMIT_MESSAGES_PER_SEC=10
WS_RATE_LIMIT_BYTES_PER_SEC=65536
WS_MAX_FRAME_BYTES=32768
PRESENCE_TTL_SECONDS=3600
